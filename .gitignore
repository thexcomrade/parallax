```gitignore
# Environment & Secrets
.env
.env.*
*.env
!.env.example

# Python
__pycache__/
*.py[cod]
*.so
.venv/
venv/
env/
build/
dist/
*.egg-info/

# Testing & Linting
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
test-results/
playwright-report/
blob-report/

# Node & Frontend
node_modules/
frontend/dist/
dist-ssr/
*.local
.npm/

# Data & Storage
/datasets/
/storage/
*.db
*.sqlite
*.sqlite3

# Generated Reports & Experiments
/reports/
/experiments/
/docs/
/backup/
/backups/
/archives/
/archive/

# Model Weights & Checkpoints
/checkpoints/
*.pt
*.pth
*.ckpt
*.safetensors
*.onnx
/backend/app/ml/weights/*
!/backend/app/ml/weights/.gitkeep
!/backend/app/ml/weights/model_card.json

# OS & Editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Generated TypeScript cache
*.tsbuildinfo

# Dataset manifests
/datasets/manifests/