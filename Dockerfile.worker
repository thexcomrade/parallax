# Dedicated CUDA-enabled GPU Inference Worker Container for PARALLAX (README §8.1, §13, Phase 7B.9)
# Base: Official PyTorch CUDA 12.4 runtime image with pre-installed cuDNN 9, PyTorch 2.4.0, torchvision, and torchaudio.
FROM pytorch/pytorch:2.4.0-cuda12.4-cudnn9-runtime

# Prevent Python from writing .pyc files and buffer stdout/stderr
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    APP_ENV=production \
    PROCESS_ROLE=worker \
    STORAGE_DIR=/app/storage \
    WORKER_MAX_CONCURRENCY=1 \
    INFERENCE_DEVICE=cuda:0 \
    REQUIRE_GPU=true

# Install system dependencies: ffmpeg, media libraries, curl for diagnostics
RUN (apt-get update --fix-missing || (sleep 5 && apt-get update --fix-missing)) && apt-get install -y --no-install-recommends \
    ffmpeg \
    libsm6 \
    libxext6 \
    libgl1 \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Security: Create non-root application user matching the API container UID/GID
RUN groupadd -g 10001 parallax && \
    useradd -u 10001 -g parallax -s /bin/bash -m parallax

WORKDIR /app

# Install backend dependencies without overwriting the pre-installed CUDA PyTorch
COPY backend/requirements-worker.txt ./backend/
RUN pip install --no-cache-dir --upgrade pip setuptools wheel && \
    pip install --no-cache-dir -r ./backend/requirements-worker.txt

# Copy backend source code & migrations
COPY backend/ ./backend/
RUN pip install --no-cache-dir --no-deps -e "./backend"

# Setup persistent storage directory with correct ownership
RUN mkdir -p /app/storage/uploads /app/storage/artifacts /app/storage/scratch && \
    chown -R parallax:parallax /app

# Switch to non-root user
USER parallax

# Healthcheck verifying worker process, Redis, model access, and GPU operation
HEALTHCHECK --interval=20s --timeout=10s --start-period=15s --retries=3 \
    CMD python -m app.workers.healthcheck || exit 1

# Start the standalone inference worker
CMD ["python", "-m", "app.workers.inference_worker"]
