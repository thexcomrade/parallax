# PARALLAX — Public Demo Environment Configuration Template (.env.demo.example)
# Copy this template to .env.demo and fill in credentials for local demo execution.
# NEVER commit .env.demo to version control.

APP_ENV=staging
PROCESS_ROLE=api
SECRET_KEY=
POSTGRES_USER=parallax_staging
POSTGRES_PASSWORD=
POSTGRES_DB=parallax_staging
DATABASE_URL=postgresql+psycopg://parallax_staging:${POSTGRES_PASSWORD}@staging-postgres:5432/parallax_staging
REDIS_URL=redis://staging-redis:6379/0
STORAGE_DIR=/app/storage
STORAGE_BACKEND=local
REQUIRE_GPU=true
INFERENCE_DEVICE=cuda:0
WORKER_MAX_CONCURRENCY=1
MODEL_PATH=./app/ml/weights/avt2_dwf.pt
LOG_FORMAT=json
METRICS_ENABLED=true
COOKIE_SECURE=false
MAX_UPLOAD_MB=90
MAX_DURATION_S=60
FEED_CACHE_TTL_S=3600
API_WORKERS=4
CORS_ORIGINS=http://localhost:8080,https://*.trycloudflare.com
